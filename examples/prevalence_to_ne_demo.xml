<!-- 
    Example demonstrating how to convert prevalence trajectories to effective population sizes (Ne)
    using the PrevalenceToNeSkygrowth component. This is typically used downstream of a prevalence
    estimation to connect to phylodynamic models.
-->
<beast version="2.7" namespace="beast.base:beast.evolution:beast.inference:beast.core:mascotdatastreams.dynamics:mascot.parameterdynamics:mascot.dynamics:mascot.util">

    <!-- Define prevalence dynamics per deme using skygrowth -->
    <PrevalenceSkygrowth id="PrevDeme1" spec="mascotdatastreams.dynamics.PrevalenceSkygrowth">
        <logPrevalence spec="beast.base.inference.parameter.RealParameter" value="1.6094 1.9459 2.1972"/>
        <rateShifts id="rs1" spec="mascot.dynamics.RateShifts" value="0.5 1.0"/>
    </PrevalenceSkygrowth>

    <PrevalenceSkygrowth id="PrevDeme2" spec="mascotdatastreams.dynamics.PrevalenceSkygrowth">
        <logPrevalence spec="beast.base.inference.parameter.RealParameter" value="1.0986 1.3863 1.6094"/>
        <rateShifts id="rs2" spec="mascot.dynamics.RateShifts" value="0.5 1.0"/>
    </PrevalenceSkygrowth>

    <!-- 
        Convert prevalence to Ne per deme using PrevalenceToNeSkygrowth.
        Each references the corresponding PrevalenceSkygrowth via idref.
    -->
    <PrevalenceToNeSkygrowth id="NeFromPrevDeme1" spec="mascotdatastreams.dynamics.PrevalenceToNeSkygrowth">
        <prevalence idref="PrevDeme1"/>
        <uninfectiousRate spec="beast.base.inference.parameter.RealParameter" value="0.2"/>
        <coalescentScale spec="beast.base.inference.parameter.RealParameter" value="2.0"/>
    </PrevalenceToNeSkygrowth>

    <PrevalenceToNeSkygrowth id="NeFromPrevDeme2" spec="mascotdatastreams.dynamics.PrevalenceToNeSkygrowth">
        <prevalence idref="PrevDeme2"/>
        <uninfectiousRate spec="beast.base.inference.parameter.RealParameter" value="0.2"/>
        <coalescentScale spec="beast.base.inference.parameter.RealParameter" value="2.0"/>
    </PrevalenceToNeSkygrowth>

    <!-- 
        Assemble individual Ne trajectories into a list compatible with StructuredSkyline
        This allows the Ne trajectories to be used in downstream phylodynamic analyses.
    -->
    <InitializedNeDynamicsList id="NeList" spec="mascot.util.InitializedNeDynamicsList">
        <neDynamics idref="NeFromPrevDeme1"/>
        <neDynamics idref="NeFromPrevDeme2"/>
    </InitializedNeDynamicsList>

    <!-- 
        Downstream components (e.g., StructuredSkyline) would consume NeList as usual.
        Example:
        <distribution id="skyline" spec="mascot.dynamics.StructuredSkyline">
            <neDynamics idref="NeList"/>
            <tree idref="tree"/>
        </distribution>
    -->

    <!-- 
        MCMC configuration for inference
        Note: In a real analysis, you would also need to define priors, operators, and loggers
    -->
    <run id="mcmc" spec="MCMC" chainLength="1000000">
        <logger id="screenlog" logEvery="1000">
            <log idref="NeFromPrevDeme1"/>
            <log idref="NeFromPrevDeme2"/>
        </logger>
        <logger id="tracelog" fileName="prevalence_to_ne.log" logEvery="1000">
            <log idref="NeFromPrevDeme1"/>
            <log idref="NeFromPrevDeme2"/>
        </logger>
    </run>

</beast>
