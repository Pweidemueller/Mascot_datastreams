<!-- Example of prevalence modeling with Mascot Skygrowth for CaseCountLikelihood (per-deme inputs) -->
    <beast version="2.7" namespace="beast.base:beast.evolution:beast.inference:beast.core:mascotdatastreams.distribution:mascot.parameterdynamics:mascot.dynamics">

    <!-- Prevalence dynamics per deme using Mascot's Skygrowth (logNe corresponds to log I(t)) -->
    <!-- Deme 0 -->
    <Skygrowth id="PrevDeme0" spec="mascot.parameterdynamics.Skygrowth">
        <logNe spec="beast.base.inference.parameter.RealParameter" value="1.6094 1.9459 2.1972"/>
        <rateShifts id="rs0" spec="mascot.dynamics.RateShifts" value="0.5 1.0"/>
    </Skygrowth>
    
    <!-- Deme 1 -->
    <Skygrowth id="PrevDeme1" spec="mascot.parameterdynamics.Skygrowth">
        <logNe spec="beast.base.inference.parameter.RealParameter" value="1.0986 1.3863 1.6094"/>
        <rateShifts id="rs1" spec="mascot.dynamics.RateShifts" value="0.5 1.0"/>
    </Skygrowth>

    <!-- Per-deme case-count observations and times -->
    <!-- Deme 0 -->
    <caseCounts id="caseCounts.Deme0" spec="beast.base.inference.parameter.RealParameter" dimension="5" value="5 7 6 8 10"/>
    <caseTimes id="caseTimes.Deme0" spec="beast.base.inference.parameter.RealParameter" dimension="5" value="0.0 0.1 0.11 0.24 0.3"/>
    <!-- Deme 1 -->
    <caseCounts id="caseCounts.Deme1" spec="beast.base.inference.parameter.RealParameter" dimension="5" value="3 4 5 6 8"/>
    <caseTimes id="caseTimes.Deme1" spec="beast.base.inference.parameter.RealParameter" dimension="5" value="0.0 0.15 0.16 0.25 0.37"/>

    <!-- Distribution for the case counts (Gamma-Poisson / Negative Binomial) -->
    <GammaPoisson id="CaseCountDist" spec="mascotdatastreams.distribution.GammaPoisson">
        <!-- Mean of the distribution (will be scaled by prevalence) -->
        <mean spec="beast.base.inference.parameter.RealParameter" value="1.0"/>
        <!-- Dispersion parameter (smaller = more overdispersed) -->
        <dispersion spec="beast.base.inference.parameter.RealParameter" value="0.5"/>
    </GammaPoisson>

    <!-- Likelihood components per deme (single-deme mode) -->
    <distribution id="CaseCountLikelihoodDeme0" spec="mascotdatastreams.distribution.CaseCountLikelihood">
        <prevalence idref="PrevDeme0"/>
        <caseCounts idref="caseCounts.Deme0"/>
        <caseTimes idref="caseTimes.Deme0"/>
        <distribution idref="CaseCountDist"/>
    </distribution>
    <distribution id="CaseCountLikelihoodDeme1" spec="mascotdatastreams.distribution.CaseCountLikelihood">
        <prevalence idref="PrevDeme1"/>
        <caseCounts idref="caseCounts.Deme1"/>
        <caseTimes idref="caseTimes.Deme1"/>
        <distribution idref="CaseCountDist"/>
    </distribution>

    <!-- Optional: Loggers for MCMC output -->
    <run id="mcmc" spec="MCMC" chainLength="1000000">
        <logger id="screenlog" logEvery="1000">
            <log idref="CaseCountLikelihoodDeme0"/>
            <log idref="CaseCountLikelihoodDeme1"/>
        </logger>
        <logger id="tracelog" fileName="prevalence.log" logEvery="1000" mode="tree">
            <log idref="CaseCountLikelihoodDeme0"/>
            <log idref="CaseCountLikelihoodDeme1"/>
            <log idref="PrevDeme0.logPrevalence"/>
            <log idref="PrevDeme1.logPrevalence"/>
        </logger>
    </run>
