<?xml version="1.0" encoding="UTF-8"?>
<package name='MascotDatastreams' version='0.0.1'>
  <depends on='BEAST.base' atleast='2.7.2'/>
  <depends on='BEAST.app' atleast='2.7.2'/>
  <depends on="Mascot" atleast="3.0.0"/>

  <service type="beast.base.core.BEASTInterface">
    <provider classname="mascotdatastreams.distribution.CaseCountLikelihood"/>
    <provider classname="mascotdatastreams.distribution.GammaPoisson"/>
    <provider classname="mascotdatastreams.distribution.SeroprevalenceLikelihood"/>
    <provider classname="mascotdatastreams.distribution.Binomial"/>
    <provider classname="mascotdatastreams.distribution.StructuredSkylinePrevalence"/>
    <provider classname="mascotdatastreams.distribution.WastewaterLikelihood"/>
    <provider classname="mascotdatastreams.distribution.LogNormal"/>
    <provider classname="mascotdatastreams.distribution.MascotLogPflag"/>
    <provider classname="mascotdatastreams.dynamics.Spline"/>
    <provider classname="mascotdatastreams.dynamics.SplinePrevalenceToNe"/>
    <provider classname="mascotdatastreams.util.TransmissionSmallerThan"/>
    <provider classname="mascotdatastreams.util.LocalTransmissionSmallerThan"/>
    <provider classname="mascotdatastreams.operators.UpDownLogScaleOperator"/>
    <provider classname="mascotdatastreams.operators.BactrianRandomWalkOperator"/>
    <provider classname="mascotdatastreams.operators.BactrianRandomWalkBlockOperator"/>
    <provider classname="mascotdatastreams.logger.CumulativeIncidenceLogger"/>
    <provider classname="mascotdatastreams.logger.StructuredTreeLogger"/>

  </service>
</package>
